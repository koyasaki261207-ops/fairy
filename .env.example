# ========================================================
# CẤU HÌNH GEMINI AUTOPILOT
# ========================================================

# Khóa API Google Gemini (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Mô hình Gemini muốn dùng (gemini-3.5-flash hoặc gemini-3.8-flash)
# Các lựa chọn: gemini-3.5-flash, gemini-3.8-flash, gemini-3.7-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Chế độ tự động hóa:
# hybrid (kết hợp PowerShell + UIAutomation + Vision - Nhanh nhất)
# vision_only (chỉ dùng chuột/bàn phím mô phỏng người dùng)
EXECUTION_MODE=hybrid

# Số bước tối đa cho một nhiệm vụ (để tránh lặp vô tận)
MAX_STEPS=30

# Độ trễ giữa các hành động (giây) để người dùng kịp quan sát
ACTION_DELAY=0.4

# Chế độ an toàn: Yêu cầu xác nhận nếu có lệnh nhạy cảm
SAFE_MODE=true

# Nhà cung cấp AI: gemini hoặc claude
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ========================================================
# TỐI ƯU TOKEN & HIỆU NĂNG
# ========================================================
# Số ảnh chụp màn hình gần nhất giữ trong lịch sử (ảnh cũ hơn bị thay bằng ghi chú chữ)
KEEP_SCREENSHOTS=1
# Độ dài tối đa (ký tự) của mỗi kết quả công cụ gửi lên AI
MAX_TOOL_RESULT_CHARS=4000
# Khi lịch sử vượt ngưỡng (ký tự), nén các kết quả công cụ cũ
HISTORY_COMPACT_CHARS=60000
# Giới hạn token đầu ra mỗi lượt (Claude)
MAX_OUTPUT_TOKENS=2048
# Ảnh chụp màn hình gửi lên AI: cạnh dài tối đa (px) và chất lượng JPEG
SCREENSHOT_MAX_DIM=1280
SCREENSHOT_QUALITY=70
# Lưu mỗi ảnh chụp ra logs/screenshots (chậm hơn, tốn đĩa) - chỉ bật khi cần debug
SAVE_SCREENSHOTS=false
# Độ phân giải ảnh của Gemini: để trống (mặc định), low, medium, high (medium/low tiết kiệm token ảnh)
GEMINI_MEDIA_RESOLUTION=
